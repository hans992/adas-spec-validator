# All keys are optional. Without provider keys, AEC Chat uses deterministic fallback mode.
# Provider priority: Gemini (GOOGLE_GENERATIVE_AI_API_KEY) -> OpenAI (OPENAI_API_KEY) -> fallback.
GOOGLE_GENERATIVE_AI_API_KEY=
GOOGLE_GENERATION_MODEL=gemini-2.5-flash
OPENAI_API_KEY=

# Supabase persistence and project-scoped machine API support.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never expose this value through NEXT_PUBLIC_* variables.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only secrets for durable webhook delivery and retry dispatch.
WEBHOOK_ENCRYPTION_KEY=
WEBHOOK_DISPATCH_SECRET=

# Shared rate limiting (Upstash Redis REST). Optional: without these values an
# in-memory per-instance fallback is used, which is only suitable for local dev.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
